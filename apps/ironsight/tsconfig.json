{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src", "test", "config"],
  // settings.test.ts imports client/settings.ts, which defaults to
  // `window.localStorage` (a DOM global) — it's typechecked under
  // tsconfig.client.json's DOM lib instead, see that file's include.
  "exclude": ["dist", "node_modules", "test/settings.test.ts", "test/switchyard-architecture.test.ts", "test/impact-vfx.test.ts"]
}
