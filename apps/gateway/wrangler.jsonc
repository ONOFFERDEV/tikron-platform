{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tikron-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // Canonical production host (Cloudflare Registrar zone on this account);
  // the workers.dev URL keeps working as a secondary.
  "routes": [
    { "pattern": "tikron.dev", "custom_domain": true },
    { "pattern": "www.tikron.dev", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GameRoom", "class_name": "GameRoom" },
      { "name": "FixtureRoom", "class_name": "FixtureRoom" },
      { "name": "Matchmaker", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["MovementRoom", "TicTacToe"] },
    { "tag": "v3", "new_sqlite_classes": ["AgarRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["Matchmaker"] },
    { "tag": "v5", "new_sqlite_classes": ["ShooterRoom"] },
    { "tag": "v6", "new_sqlite_classes": ["MmoRoom"] },
    // The demo games were removed on 2026-09-07; FixtureRoom replaces them as the
    // gateway's one generic realtime room (see src/fixture-room.ts).
    {
      "tag": "v7",
      "new_sqlite_classes": ["FixtureRoom"],
      "deleted_classes": ["MovementRoom", "TicTacToe", "AgarRoom", "ShooterRoom", "MmoRoom"]
    }
  ],
  // Platform database (M5). database_id is filled in by `wrangler d1 create`;
  // local dev + vitest-pool-workers use a local SQLite regardless of the id.
  // Migrations live in ./migrations. NOTE: database_name intentionally keeps the
  // legacy "playedge-platform" (and its id) through the Tikron rename — renaming
  // it would orphan the live production data.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "playedge-platform",
      "database_id": "f8fcf3e3-8df9-400c-811d-a6eb959ba884",
      "migrations_dir": "migrations"
    }
  ],
  "assets": { "directory": "./public" },
  "vars": {
    // Keyless connects are attributed to this project so they stay metered +
    // capped in production. Row seeded via scripts/seed-demo.sql.
    "DEMO_PROJECT_ID": "demo",
    // www -> apex 301 + pins the GitHub OAuth flow to this host (the OAuth
    // app's registered callback is host-exact).
    "CANONICAL_HOST": "tikron.dev",
    // GitHub user ids allowed to moderate the public showcase (comma-separated).
    "ADMIN_GITHUB_IDS": "144263374"
  },
  "observability": { "enabled": true }
}
