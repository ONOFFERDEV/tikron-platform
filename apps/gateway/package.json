{
  "name": "@tikron/gateway",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm copy-docs && wrangler deploy",
    "build": "pnpm copy-docs && wrangler deploy --dry-run --outdir dist",
    "copy-docs": "node scripts/copy-docs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tikron/protocol": "workspace:*",
    "@tikron/schema": "workspace:*",
    "@tikron/server": "workspace:*",
    "partyserver": "^0.5.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.17.0",
    "@cloudflare/workers-types": "^4.20260701.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.106.0"
  }
}
